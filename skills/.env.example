# ─────────────────────────────────────────────────────────────────────────────
# BMAD DEPT Code Agent — Token Budget Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Total token budget allocated per session (context window)
BMAD_TOKEN_BUDGET_TOTAL=128000

# Warning threshold — show amber warning when remaining drops below this %
BMAD_TOKEN_WARNING_PERCENT=20

# Critical threshold — show red alert when remaining drops below this %
BMAD_TOKEN_CRITICAL_PERCENT=10

# Token cost per 1K tokens (USD) — for cost projection display
BMAD_TOKEN_COST_PER_1K_INPUT=0.003
BMAD_TOKEN_COST_PER_1K_OUTPUT=0.015

# Static scanner average token usage (pre-measured baselines)
BMAD_STATIC_SCAN_TOKENS_AVG=1200
BMAD_STATIC_AUDIT_TOKENS_AVG=1500
BMAD_STATIC_COVERAGE_TOKENS_AVG=1800
BMAD_STATIC_IMPACT_TOKENS_AVG=1400
BMAD_STATIC_SONAR_TOKENS_AVG=1600
BMAD_LLM_STATIC_REQUIREMENTS_TOKENS_AVG=1500
BMAD_STATIC_ARCHITECTURE_TOKENS_AVG=1500
BMAD_STATIC_RELEASE_TOKENS_AVG=1500
BMAD_STATIC_OPERATIONS_TOKENS_AVG=1500

# LLM-assisted mode average token usage (pre-measured baselines)
BMAD_LLM_SCAN_TOKENS_AVG=18000
BMAD_LLM_AUDIT_TOKENS_AVG=25000
BMAD_LLM_COVERAGE_TOKENS_AVG=32000
BMAD_LLM_IMPACT_TOKENS_AVG=22000
BMAD_LLM_GENERATION_TOKENS_AVG=45000
BMAD_LLM_SONAR_TOKENS_AVG=28000
BMAD_LLM_REQUIREMENTS_TOKENS_AVG=30000
BMAD_LLM_ARCHITECTURE_TOKENS_AVG=30000
BMAD_LLM_RELEASE_TOKENS_AVG=25000
BMAD_LLM_OPERATIONS_TOKENS_AVG=25000

# Optimized prompt multiplier — factor reduction after prompt optimization
# e.g., 0.6 means optimized prompts use 60% of naive LLM token cost
BMAD_OPTIMIZED_PROMPT_MULTIPLIER=0.6
