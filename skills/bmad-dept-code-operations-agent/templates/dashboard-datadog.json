{
  "title": "{{SERVICE}} — Golden Signals ({{ENV}})",
  "description": "Golden-signals dashboard for {{SERVICE}} on {{STACK}}. Widgets: uptime, latency (p50/p95/p99), error rate, throughput, saturation, log-error rate, top errors, deploy markers. Generated by BMAD DCA Operations agent.",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "template_variables": [
    { "name": "env", "prefix": "env", "available_values": ["stage", "prod"], "default": "prod" },
    { "name": "service", "prefix": "service", "default": "{{SERVICE}}" },
    { "name": "region", "prefix": "region", "default": "*" }
  ],
  "widgets": [
    {
      "definition": {
        "title": "Uptime — last 24h",
        "type": "check_status",
        "check": "http.can_connect",
        "grouping": "check",
        "group_by": ["host", "instance"],
        "tags": ["service:$service", "env:$env"]
      }
    },
    {
      "definition": {
        "title": "Latency (p50 / p95 / p99)",
        "type": "timeseries",
        "requests": [
          { "q": "avg:{{METRIC_LATENCY_P50}}{service:$service, env:$env}", "display_type": "line", "style": {"palette": "cool"} },
          { "q": "avg:{{METRIC_LATENCY_P95}}{service:$service, env:$env}", "display_type": "line", "style": {"palette": "warm"} },
          { "q": "avg:{{METRIC_LATENCY_P99}}{service:$service, env:$env}", "display_type": "line", "style": {"palette": "purple"} }
        ],
        "yaxis": {"scale": "linear", "label": "ms", "include_zero": true},
        "markers": [
          {"value": "y = {{SLO_LATENCY_P95_MS}}", "display_type": "error dashed", "label": "SLO p95 threshold"}
        ]
      }
    },
    {
      "definition": {
        "title": "Error rate (%)",
        "type": "timeseries",
        "requests": [
          { "q": "100 * sum:{{METRIC_ERRORS}}{service:$service, env:$env}.as_count() / sum:{{METRIC_REQUESTS}}{service:$service, env:$env}.as_count()", "display_type": "line" }
        ],
        "yaxis": {"scale": "linear", "label": "%", "min": "0", "max": "5"},
        "markers": [
          {"value": "y = {{SLO_ERROR_RATE_PCT}}", "display_type": "error dashed", "label": "SLO error-rate threshold"}
        ]
      }
    },
    {
      "definition": {
        "title": "Throughput (RPS)",
        "type": "query_value",
        "requests": [
          { "q": "sum:{{METRIC_REQUESTS}}{service:$service, env:$env}.as_rate()", "aggregator": "avg" }
        ],
        "precision": 1
      }
    },
    {
      "definition": {
        "title": "Saturation — {{SATURATION_LABEL}}",
        "type": "timeseries",
        "requests": [
          { "q": "avg:{{METRIC_SATURATION}}{service:$service, env:$env}", "display_type": "area" }
        ],
        "yaxis": {"scale": "linear", "label": "%", "min": "0", "max": "100"},
        "markers": [
          {"value": "y = 80", "display_type": "warning dashed", "label": "warn 80%"},
          {"value": "y = 90", "display_type": "error dashed", "label": "critical 90%"}
        ]
      }
    },
    {
      "definition": {
        "title": "Log-error rate — {{SERVICE}}",
        "type": "timeseries",
        "requests": [
          { "q": "logs('service:$service env:$env status:error').index('*').rollup('count').as_count()", "display_type": "bars" }
        ]
      }
    },
    {
      "definition": {
        "title": "Top errors (last 1h)",
        "type": "toplist",
        "requests": [
          { "q": "top(sum:{{METRIC_ERRORS}}{service:$service, env:$env} by {error_type}.as_count(), 10, 'sum', 'desc')" }
        ]
      }
    },
    {
      "definition": {
        "title": "Deploy markers ({{STACK}})",
        "type": "event_stream",
        "query": "tags:service:$service tags:env:$env sources:deploy",
        "event_size": "s"
      }
    }
  ],
  "notify_list": ["{{ONCALL_HANDLE}}"],
  "tags": ["service:{{SERVICE}}", "stack:{{STACK}}", "generated-by:bmad-dca-operations"]
}
